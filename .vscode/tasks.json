{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build api",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/api/SevenHabits.Api.csproj"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "web: start",
      "type": "npm",
      "script": "start",
      "path": "src/web",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": {
          "regexp": "^ERROR in (.*)",
          "file": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building\\.\\.\\.",
          "endsPattern": "Local:\\s+http://localhost:4200"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
