  "about": {
    "paradigms": {
      "inShort": "قبل ما تغيّر أي عادة، بص على العدسة اللي بتبص منها أصلاً. الكتاب بيسمي العدسة دي «إطار ذهني». التمارين دي هتوريك إزاي بتأثر على اللي بتعمله واللي بتوصله."
    },
    "h1": {
      "inShort": "العادة الأولى إنك تختار رد فعلك، بدل ما الظروف تختار عنك. هتلاحظ فين تقدر تفرق، وتتحرك هناك وانت قاصد."
    },
    "h2": {
      "inShort": "العادة التانية إنك تعرف رايح فين قبل ما تبدأ. هتكتب انت واقف على إيه، والأدوار اللي تهمك. وساعتها اختياراتك كل يوم هيبقى ليها اتجاه."
    },
    "h3": {
      "inShort": "العادة التالتة بتحوّل أهم حاجاتك لخطة كل أسبوع. هتعمل وقت للحاجات المهمة، مش بس للحاجات اللي صوتها عالي."
    },
    "h4": {
      "inShort": "العادة الرابعة بتدوّر على اتفاق الطرفين يكسبوا فيه. هتتمرن على اتفاقات محدش فيها لازم يخسر."
    },
    "h5": {
      "inShort": "العادة الخامسة إنك تسمع بجد قبل ما تقول رأيك. هتتمرن تسمع اللي قدامك للآخر، وبعدين تطلب إنه يسمعك."
    },
    "h6": {
      "inShort": "العادة السادسة إنك تجمع وجهات نظر مختلفة في حاجة أحسن من كل واحدة لوحدها. هتتمرن تشوف الاختلاف مصدر لأفكار جديدة."
    },
    "h7": {
      "inShort": "العادة السابعة إنك تاخد بالك من نفسك: جسمك وعقلك وقلبك وروحك. هتبني عادات صغيرة تخليك مكمّل، بدل ما تفضل شغال لحد ما تفصل."
    },
    "interdependence": {
      "inShort": "الشغل مع الناس محتاج ثقة، والثقة بتتبني خطوة خطوة. هتتابع الحاجات الصغيرة اللي بتبنيها أو بتهدّها. الكتاب بيسمي ده «الحساب المصرفي العاطفي»."
    }
  },
