{
  "name": "sevenhabitstools-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "e2e": "playwright test",
    "lint": "ng lint && npm run stylelint && npm run format:check",
    "stylelint": "stylelint \"src/**/*.scss\"",
    "format": "prettier --write \"{src,e2e}/**/*.{ts,html,scss}\" \"playwright.config.ts\"",
    "format:check": "prettier --check \"{src,e2e}/**/*.{ts,html,scss}\" \"playwright.config.ts\""
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=11"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/material": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@angular/service-worker": "^22.1.7",
    "@fontsource/material-symbols-outlined": "^5.3.7",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.8",
    "stylelint": "^17.15.0",
    "stylelint-use-logical": "^2.1.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "~5.0.1"
  }
}
