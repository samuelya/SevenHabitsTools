# Copy to .env for `docker compose up`. All variables are optional for local MVP work;
# leave them blank unless you're testing Cloud Sync OAuth or Application Insights.

# Application Insights connection string for the api container. Leave blank to disable telemetry.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Cloud Sync OAuth client IDs (blocked:prerequisites for MVP; safe to leave blank).
MS_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=
OAUTH_SECRETS_CONFIGURED=false
